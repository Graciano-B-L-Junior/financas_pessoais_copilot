# Production environment variables for the backend
# Replace placeholder values before deploying to production.

DEBUG=0
SECRET_KEY=change-me-prod
ALLOWED_HOSTS=backend,frontend,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Database settings used by Django
DB_NAME=financas_prod
DB_USER=financas_prod
DB_PASSWORD=financas_prod_pass
DB_HOST=db
DB_PORT=5432

# Postgres container initialization variables used by docker-compose
POSTGRES_USER=financas_prod
POSTGRES_PASSWORD=financas_prod_pass
POSTGRES_DB=financas_prod

# Redis
REDIS_URL=redis://redis:6379/0

# JWT / auth token lifetime
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

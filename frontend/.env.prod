# Frontend Production Environment Variables
# IMPORTANT: Adjust these values for your production domain

# API Base URL
API_URL=https://yourdomain.com
API_VERSION=v1

# Application
NODE_ENV=production
PORT=3000
DEBUG=false

# Locale
LOCALE=pt-BR
CURRENCY=BRL

# Features
FEATURE_RECURRENCE=true
FEATURE_ANALYTICS=true

# Logging
LOG_LEVEL=warn

# Security
CORS_ORIGIN=https://yourdomain.com

# URL interna do backend Django (acessada pelo servidor Next.js)
BACKEND_API_URL=http://localhost:8000/api/v1

# Nome da aplicação
APP_NAME=Financas Pessoais

# Ativar secure em cookies (true em produção com HTTPS)
COOKIE_SECURE=false

# Locale e moeda
LOCALE=pt-BR
CURRENCY=BRL

# Porta do servidor
PORT=3000

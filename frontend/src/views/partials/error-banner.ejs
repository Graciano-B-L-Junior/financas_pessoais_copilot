<% if (errors && errors.general && errors.general.length) { %>
  <div class="alert alert--danger" role="alert">
    <strong>Nao foi possivel concluir a operacao.</strong>
    <ul class="field-errors" style="margin-top: 0.6rem;">
      <% errors.general.forEach(function(message) { %>
        <li><%= message %></li>
      <% }); %>
    </ul>
  </div>
<% } %>
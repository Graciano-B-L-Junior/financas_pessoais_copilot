<header class="container page-shell">
  <div class="app-header">
    <div class="brand">
      <div class="brand-mark">FP</div>
      <div class="brand-text">
        <strong><%= appName %></strong>
        <span><%= currentUser ? `${currentUser.first_name || ''} ${currentUser.last_name || ''}`.trim() || currentUser.email : 'Seu painel financeiro' %></span>
      </div>
    </div>

    <nav class="nav-links" aria-label="Navegacao do modulo">
      <a class="<%= isActivePath(currentPath, '/dashboard') ? 'is-active' : '' %>" href="/dashboard">Dashboard</a>
      <a class="<%= isActivePath(currentPath, '/categorias') ? 'is-active' : '' %>" href="/categorias">Categorias</a>
      <a class="<%= isActivePath(currentPath, '/lancamentos') ? 'is-active' : '' %>" href="/lancamentos">Lancamentos</a>
      <a class="<%= isActivePath(currentPath, '/perfil') ? 'is-active' : '' %>" href="/perfil">Perfil</a>
      <a class="<%= isActivePath(currentPath, '/analises') ? 'is-active' : '' %>" href="/analises">Analises</a>
    </nav>

    <div class="app-session">
      <div class="chip">
        <span class="brand-mark" style="width: 2.25rem; height: 2.25rem; border-radius: 999px; font-size: 0.85rem;"> <%= getInitials(currentUser) %> </span>
        <span><%= currentUser ? currentUser.email : 'Conta autenticada' %></span>
      </div>
      <form class="inline-form" method="post" action="/logout">
        <button class="btn btn--ghost" type="submit">Sair</button>
      </form>
    </div>
  </div>
</header>
<%- include('partials/head', { bodyClass: 'page--app', pageTitle }) %>
<%- include('partials/nav-app') %>

<main class="container page-shell shell-grid">
  <section class="surface panel">
    <div class="page-heading">
      <span class="eyebrow">Dashboard</span>
      <h1>Seu resumo financeiro</h1>
      <p>Visao consolidada com filtros por periodo, categoria, tipo, recorrencia e faixa de valor.</p>
      <div class="chip">Atualizado a partir da API em tempo real</div>
    </div>

    <form class="filters" method="get" action="/dashboard">
      <label class="field search-field search-field--narrow">
        <span>Inicio</span>
        <input type="date" name="start" value="<%= filters.start || '' %>" />
      </label>
      <label class="field search-field search-field--narrow">
        <span>Fim</span>
        <input type="date" name="end" value="<%= filters.end || '' %>" />
      </label>
      <label class="field search-field">
        <span>Categoria</span>
        <select name="category">
          <option value="">Todas</option>
          <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>" <%= String(filters.category || '') === String(category.id) ? 'selected' : '' %>><%= category.label %></option>
          <% }); %>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Tipo</span>
        <select name="type">
          <option value="">Todos</option>
          <option value="receita" <%= filters.type === 'receita' ? 'selected' : '' %>>Receita</option>
          <option value="despesa" <%= filters.type === 'despesa' ? 'selected' : '' %>>Despesa</option>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Recorrente</span>
        <select name="is_recurring">
          <option value="">Todos</option>
          <option value="true" <%= filters.is_recurring === 'true' ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= filters.is_recurring === 'false' ? 'selected' : '' %>>Nao</option>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Valor minimo</span>
        <input type="text" id="minAmountInput" name="min_amount" value="<%= filters.min_amount || '' %>" placeholder="0,00" />
      </label>
      <label class="field search-field search-field--narrow">
        <span>Valor maximo</span>
        <input type="text" id="maxAmountInput" name="max_amount" value="<%= filters.max_amount || '' %>" placeholder="0,00" />
      </label>
      <button class="btn btn--primary" type="submit">Aplicar filtros</button>
    </form>
  </section>

  <section class="metric-grid">
    <script>
      // Máscara monetária BRL para filtros de valor
      (function() {
        function mask(input) {
          input.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length === 0) {
              e.target.value = '';
            } else {
              value = (parseInt(value) / 100).toLocaleString('pt-BR', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
              });
              e.target.value = value;
            }
          });
        }
        const minInput = document.getElementById('minAmountInput');
        const maxInput = document.getElementById('maxAmountInput');
        if (minInput) mask(minInput);
        if (maxInput) mask(maxInput);
      })();
    </script>
    <article class="metric surface">
      <span class="stat-label">Receitas</span>
      <div class="metric-value metric-value--accent"><%= formatCurrency(dashboard.summary?.total_income || 0) %></div>
      <p class="metric-desc">Total do periodo filtrado.</p>
    </article>
    <article class="metric surface">
      <span class="stat-label">Despesas</span>
      <div class="metric-value metric-value--negative"><%= formatCurrency(dashboard.summary?.total_expenses || 0) %></div>
      <p class="metric-desc">Saidas consolidadas do periodo.</p>
    </article>
    <article class="metric surface">
      <span class="stat-label">Saldo</span>
      <div class="metric-value <%= Number(dashboard.summary?.balance || 0) >= 0 ? 'metric-value--positive' : 'metric-value--negative' %>"><%= formatCurrency(dashboard.summary?.balance || 0) %></div>
      <p class="metric-desc">Resultado entre entradas e saidas.</p>
    </article>
    <article class="metric surface">
      <span class="stat-label">Lançamentos</span>
      <div class="metric-value"><%= dashboard.summary?.transaction_count || 0 %></div>
      <p class="metric-desc">Quantidade de registros filtrados.</p>
    </article>
    <article class="metric surface">
      <span class="stat-label">Recorrentes</span>
      <div class="metric-value"><%= dashboard.summary?.recurring_count || 0 %></div>
      <p class="metric-desc">Itens com recorrencia ativa.</p>
    </article>
    <article class="metric surface">
      <span class="stat-label">Orçamento</span>
      <div class="metric-value metric-value--accent"><%= formatPercent(dashboard.budget_summary?.execution_percentage || 0) %></div>
      <p class="metric-desc">Execução do orçamento ativo.</p>
    </article>
  </section>

  <section class="charts-section">
    <style>
      .charts-section {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-xl, 2rem);
        width: 100%;
      }
      
      .chart-card {
        padding: var(--spacing-lg, 1.5rem);
        border-radius: var(--radius, 8px);
      }
      
      .chart-card canvas {
        max-height: 400px;
        margin-top: var(--spacing-md, 1rem);
      }
      
      @media (min-width: 1024px) {
        .charts-section {
          grid-template-columns: 1fr;
        }
      }
    </style>

    <article class="surface chart-card">
      <div class="page-heading">
        <span class="eyebrow">Evolução</span>
        <h2 class="section-title">Receitas vs Despesas por mês</h2>
      </div>
      <% if (dashboard.monthly_series && dashboard.monthly_series.length > 0) { %>
        <canvas id="monthlyChart"></canvas>
      <% } else { %>
        <div class="empty-state">
          <h3>Sem dados para o período</h3>
          <p>Amplie o período de filtro para visualizar a evolução mensal.</p>
        </div>
      <% } %>
    </article>

    <article class="surface chart-card">
      <div class="page-heading">
        <span class="eyebrow">Orçamento</span>
        <h2 class="section-title">Orçado vs realizado</h2>
      </div>
      <% if (dashboard.budget_series && dashboard.budget_series.length > 0) { %>
        <canvas id="budgetChart"></canvas>
      <% } else { %>
        <div class="empty-state">
          <h3>Sem orçamento cadastrado</h3>
          <p>Crie um orçamento para acompanhar a evolução entre o valor previsto e o realizado.</p>
        </div>
      <% } %>
    </article>

    <article class="surface chart-card">
      <div class="page-heading">
        <span class="eyebrow">Distribuição</span>
        <h2 class="section-title">Top categorias</h2>
      </div>
      <% if (dashboard.top_categories && dashboard.top_categories.length) { %>
        <canvas id="categoriesChart"></canvas>
      <% } else { %>
        <div class="empty-state">
          <h3>Sem categorias no periodo</h3>
          <p>Adicione lancamentos ou amplie o filtro para visualizar a distribuicao.</p>
        </div>
      <% } %>
    </article>

    <article class="surface chart-card">
      <div class="page-heading">
        <span class="eyebrow">Detalhado</span>
        <h2 class="section-title">Evolução por categoria</h2>
      </div>
      <label class="field search-field" style="margin-bottom: var(--spacing-md, 1rem);">
        <span>Selecione uma categoria</span>
        <select id="categoryFilterSelect" name="category-evolution-filter">
          <option value="">Escolha uma categoria para ver a evolução</option>
          <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>"><%= category.label %></option>
          <% }); %>
        </select>
      </label>
      <div id="categoryEvolutionContainer" style="display: none;">
        <canvas id="categoryEvolutionChart"></canvas>
      </div>
      <div id="categoryEvolutionEmpty" class="empty-state" style="display: block;">
        <h3>Selecione uma categoria</h3>
        <p>Escolha uma categoria acima para visualizar a evolução mensal de gastos.</p>
      </div>
    </article>
  </section>

  <section class="grid-2">
    <article class="surface list-card">
      <div class="page-heading">
        <span class="eyebrow">Top categorias</span>
        <h2 class="section-title">Onde o dinheiro mais circulou</h2>
      </div>

      <% if (dashboard.top_categories && dashboard.top_categories.length) { %>
        <div class="list-grid">
          <% dashboard.top_categories.forEach(function(item) { %>
            <div class="list-item">
              <div class="list-item__title">
                <strong><%= item.category %></strong>
                <span class="badge badge--primary"><%= formatCurrency(item.total || 0) %></span>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>Sem categorias no periodo</h3>
          <p>Adicione lancamentos ou amplie o filtro para visualizar a distribuicao.</p>
        </div>
      <% } %>
    </article>

    <article class="surface table-card">
      <div class="page-heading">
        <span class="eyebrow">Recentes</span>
        <h2 class="section-title">Ultimos lancamentos</h2>
        <a class="btn btn--link" href="/lancamentos">Ver todos</a>
      </div>

      <% if (recentTransactions && recentTransactions.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Descricao</th>
                <th>Categoria</th>
                <th>Tipo</th>
                <th>Data</th>
                <th>Valor</th>
              </tr>
            </thead>
            <tbody>
              <% recentTransactions.forEach(function(transaction) { %>
                <tr>
                  <td><strong><%= transaction.description %></strong></td>
                  <td><%= transaction.category?.name || transaction.category || '—' %></td>
                  <td><span class="badge <%= transaction.type === 'receita' ? 'badge--success' : 'badge--danger' %>"><%= transaction.type %></span></td>
                  <td><%= formatDate(transaction.date) %></td>
                  <td><%= formatCurrency(transaction.amount || 0) %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>Nenhum lancamento encontrado</h3>
          <p>Use o modulo de lancamentos para iniciar seu acompanhamento financeiro.</p>
        </div>
      <% } %>
    </article>
  </section>


  <section class="surface panel">
    <div class="page-heading">
      <span class="eyebrow">Proximos passos</span>
      <h2 class="section-title">Acesso rapido aos outros modulos</h2>
    </div>

    <div class="feature-grid">
      <a class="feature surface" href="/categorias" style="text-decoration: none;">
        <span class="feature-badge">Categorias</span>
        <h3>Organize receitas e despesas</h3>
        <p>Crie, edite, ative e remova categorias do jeito que o negocio exige.</p>
      </a>
      <a class="feature surface" href="/lancamentos" style="text-decoration: none;">
        <span class="feature-badge">Lancamentos</span>
        <h3>Fluxo completo de CRUD</h3>
        <p>Inclua recorrencias, filtros e edicao rapida de movimentacoes.</p>
      </a>
      <a class="feature surface" href="/analises" style="text-decoration: none;">
        <span class="feature-badge">Analises</span>
        <h3>Insights do perfil financeiro</h3>
        <p>Acompanhe proporcoes, categorias mais frequentes e alertas de comportamento.</p>
      </a>
      <a class="feature surface" href="/orcamento" style="text-decoration: none;">
        <span class="feature-badge">Orçamento</span>
        <h3>Planeje e compare gastos</h3>
        <p>Registre metas mensais e acompanhe o realizado em relacao ao previsto.</p>
      </a>
    </div>
  </section>

  <script>
    // Color palette for consistent visualization
    const colorPalette = {
      primary: '#2563eb',
      success: '#059669',
      danger: '#dc2626',
      warning: '#f59e0b',
      info: '#0891b2',
      purple: '#9333ea',
      indigo: '#4f46e5',
      pink: '#ec4899',
      teal: '#14b8a6',
      amber: '#d97706'
    };

    const categoryColors = [
      '#0f766e', '#2563eb', '#059669', '#d97706', '#dc2626',
      '#9333ea', '#4f46e5', '#ec4899', '#14b8a6', '#7c3aed'
    ];

    // Monthly chart (line)
    const monthlyCanvas = document.getElementById('monthlyChart');
    if (monthlyCanvas) {
      const monthlyData = <%- JSON.stringify(dashboard.monthly_series || []) %>;
      if (monthlyData.length > 0) {
        new Chart(monthlyCanvas, {
          type: 'line',
          data: {
            labels: monthlyData.map(m => m.month),
            datasets: [
              {
                label: 'Receitas',
                data: monthlyData.map(m => m.income),
                borderColor: colorPalette.success,
                backgroundColor: 'rgba(5, 150, 105, 0.08)',
                borderWidth: 2.5,
                tension: 0.35,
                fill: true,
                pointRadius: 4,
                pointBackgroundColor: colorPalette.success,
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointHoverRadius: 6
              },
              {
                label: 'Despesas',
                data: monthlyData.map(m => m.expenses),
                borderColor: colorPalette.danger,
                backgroundColor: 'rgba(220, 38, 38, 0.08)',
                borderWidth: 2.5,
                tension: 0.35,
                fill: true,
                pointRadius: 4,
                pointBackgroundColor: colorPalette.danger,
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointHoverRadius: 6
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            interaction: {
              mode: 'index',
              intersect: false
            },
            plugins: {
              legend: {
                position: 'top',
                labels: {
                  usePointStyle: true,
                  padding: 16,
                  font: { size: 13, weight: '500' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                titleFont: { size: 13, weight: '600' },
                bodyFont: { size: 12 },
                cornerRadius: 6,
                displayColors: true,
                callbacks: {
                  label: function(context) {
                    const value = new Intl.NumberFormat('pt-BR', {
                      style: 'currency',
                      currency: 'BRL'
                    }).format(context.parsed.y);
                    return context.dataset.label + ': ' + value;
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return new Intl.NumberFormat('pt-BR', {
                      notation: 'compact',
                      compactDisplay: 'short',
                      style: 'currency',
                      currency: 'BRL'
                    }).format(value);
                  }
                }
              }
            }
          }
        });
      }
    }

    // Budget chart (bar)
    const budgetCanvas = document.getElementById('budgetChart');
    if (budgetCanvas) {
      const budgetData = <%- JSON.stringify(dashboard.budget_series || []) %>;
      if (budgetData.length > 0) {
        new Chart(budgetCanvas, {
          type: 'bar',
          data: {
            labels: budgetData.map(item => item.month),
            datasets: [
              {
                label: 'Orçado',
                data: budgetData.map(item => item.budgeted),
                backgroundColor: 'rgba(37, 99, 235, 0.88)',
                borderColor: colorPalette.primary,
                borderWidth: 1,
                borderRadius: 10,
              },
              {
                label: 'Realizado',
                data: budgetData.map(item => item.actual),
                backgroundColor: 'rgba(217, 119, 6, 0.84)',
                borderColor: colorPalette.amber,
                borderWidth: 1,
                borderRadius: 10,
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            interaction: {
              mode: 'index',
              intersect: false
            },
            plugins: {
              legend: {
                position: 'top',
                labels: {
                  usePointStyle: true,
                  padding: 16,
                  font: { size: 13, weight: '500' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                titleFont: { size: 13, weight: '600' },
                bodyFont: { size: 12 },
                cornerRadius: 6,
                callbacks: {
                  label: function(context) {
                    const value = new Intl.NumberFormat('pt-BR', {
                      style: 'currency',
                      currency: 'BRL'
                    }).format(context.parsed.y);
                    return context.dataset.label + ': ' + value;
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return new Intl.NumberFormat('pt-BR', {
                      notation: 'compact',
                      compactDisplay: 'short',
                      style: 'currency',
                      currency: 'BRL'
                    }).format(value);
                  }
                }
              }
            }
          }
        });
      }
    }

    // Categories chart (doughnut)
    const categoriesCanvas = document.getElementById('categoriesChart');
    if (categoriesCanvas) {
      const topData = <%- JSON.stringify(dashboard.top_categories || []) %>;
      if (topData.length > 0) {
        new Chart(categoriesCanvas, {
          type: 'doughnut',
          data: {
            labels: topData.map(c => c.category),
            datasets: [{
              data: topData.map(c => c.total),
              backgroundColor: categoryColors.slice(0, topData.length),
              borderColor: '#fff',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                position: 'bottom',
                labels: {
                  padding: 12,
                  font: { size: 12, weight: '500' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                cornerRadius: 6,
                callbacks: {
                  label: function(context) {
                    const value = new Intl.NumberFormat('pt-BR', {
                      style: 'currency',
                      currency: 'BRL'
                    }).format(context.parsed);
                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                    const percentage = ((context.parsed / total) * 100).toFixed(1);
                    return context.label + ': ' + value + ' (' + percentage + '%)';
                  }
                }
              }
            }
          }
        });
      }
    }

    // Category evolution chart (dynamic, based on dropdown)
    let categoryEvolutionChart = null;
    const categorySelect = document.getElementById('categoryFilterSelect');
    const categoryEvolutionContainer = document.getElementById('categoryEvolutionContainer');
    const categoryEvolutionEmpty = document.getElementById('categoryEvolutionEmpty');
    const categoryCanvas = document.getElementById('categoryEvolutionChart');

    // Build time range from filters or default to last 12 months
    function getDateRange() {
      const params = new URLSearchParams(window.location.search);
      const start = params.get('start');
      const end = params.get('end');
      
      if (start && end) {
        return { start, end };
      }
      
      const today = new Date();
      const twelveMonthsAgo = new Date(today.getFullYear() - 1, today.getMonth(), today.getDate());
      
      return {
        start: twelveMonthsAgo.toISOString().split('T')[0],
        end: today.toISOString().split('T')[0]
      };
    }

    async function loadCategoryEvolution(categoryId) {
      if (!categoryId) {
        categoryEvolutionContainer.style.display = 'none';
        categoryEvolutionEmpty.style.display = 'block';
        if (categoryEvolutionChart) {
          categoryEvolutionChart.destroy();
          categoryEvolutionChart = null;
        }
        return;
      }

      const dateRange = getDateRange();
      const url = `/api/dashboard/category-series?category_id=${categoryId}&start=${dateRange.start}&end=${dateRange.end}`;

      try {
        const response = await fetch(url, { credentials: 'include' });
        if (response.status === 401) {
          window.location.href = '/login?next=' + encodeURIComponent(window.location.pathname + window.location.search);
          return;
        }
        if (!response.ok) throw new Error('Failed to load category data');
        
        const data = await response.json();
        const series = data.category_series || [];

        if (series.length === 0) {
          categoryEvolutionContainer.style.display = 'none';
          categoryEvolutionEmpty.style.display = 'block';
          return;
        }

        categoryEvolutionContainer.style.display = 'block';
        categoryEvolutionEmpty.style.display = 'none';

        if (categoryEvolutionChart) {
          categoryEvolutionChart.destroy();
        }

        categoryEvolutionChart = new Chart(categoryCanvas, {
          type: 'line',
          data: {
            labels: series.map(m => m.month),
            datasets: [{
              label: 'Gastos',
              data: series.map(m => m.total),
              borderColor: colorPalette.primary,
              backgroundColor: 'rgba(37, 99, 235, 0.08)',
              borderWidth: 2.5,
              tension: 0.35,
              fill: true,
              pointRadius: 4,
              pointBackgroundColor: colorPalette.primary,
              pointBorderColor: '#fff',
              pointBorderWidth: 2,
              pointHoverRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            interaction: {
              mode: 'index',
              intersect: false
            },
            plugins: {
              legend: {
                position: 'top',
                labels: {
                  usePointStyle: true,
                  padding: 16,
                  font: { size: 13, weight: '500' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                titleFont: { size: 13, weight: '600' },
                bodyFont: { size: 12 },
                cornerRadius: 6,
                callbacks: {
                  label: function(context) {
                    const value = new Intl.NumberFormat('pt-BR', {
                      style: 'currency',
                      currency: 'BRL'
                    }).format(context.parsed.y);
                    return context.dataset.label + ': ' + value;
                  }
                }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: function(value) {
                    return new Intl.NumberFormat('pt-BR', {
                      notation: 'compact',
                      compactDisplay: 'short',
                      style: 'currency',
                      currency: 'BRL'
                    }).format(value);
                  }
                }
              }
            }
          }
        });
      } catch (error) {
        console.error('Erro ao carregar série de categoria:', error);
        categoryEvolutionContainer.style.display = 'none';
        categoryEvolutionEmpty.style.display = 'block';
      }
    }

    // Event listener para mudança de categoria
    if (categorySelect) {
      categorySelect.addEventListener('change', function(e) {
        loadCategoryEvolution(e.target.value);
      });
    }
  </script>
</main>

<%- include('partials/footer') %>
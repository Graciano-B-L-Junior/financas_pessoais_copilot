<%- include('partials-head', { title }) %>
<section class="panel">
  <h1>Criar Conta</h1>
  <p>Cadastre-se para começar a gerenciar suas finanças.</p>
  
  <% if (error) { %>
    <div class="alert alert-error" style="color: red; margin-bottom: 1rem;">
      <%= error %>
    </div>
  <% } %>

  <form id="registerForm" method="POST" action="/register">
    <div class="form-group">
      <label for="first_name">Nome</label>
      <input type="text" id="first_name" name="first_name" required placeholder="Ex: João" />
    </div>

    <div class="form-group">
      <label for="last_name">Sobrenome</label>
      <input type="text" id="last_name" name="last_name" required placeholder="Ex: Silva" />
    </div>

    <div class="form-group">
      <label for="email">E-mail</label>
      <input type="email" id="email" name="email" required placeholder="joao.silva@exemplo.com" />
    </div>

    <div class="form-group">
      <label for="password">Senha</label>
      <input type="password" id="password" name="password" required placeholder="********" />
      <small>Mínimo 6 caracteres, com letras (maiúsculas/minúsculas), números e caracteres especiais.</small>
    </div>

    <button type="submit" class="btn-primary">Registrar</button>
  </form>

  <p class="mt-1">
    Já tem uma conta? <a href="/login">Faça login aqui</a>.
  </p>
</section>
<%- include('partials-foot') %>
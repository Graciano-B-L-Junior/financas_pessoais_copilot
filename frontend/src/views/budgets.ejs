<%- include('partials/head', { bodyClass: 'page--app', pageTitle }) %>
<%- include('partials/nav-app') %>

<main class="container page-shell shell-grid">
  <section class="surface panel">
    <div class="page-heading">
      <span class="eyebrow">Orçamento</span>
      <h1>Planejamento mensal de gastos</h1>
      <p>Registre seu orçamento mensal, distribua por categorias e acompanhe o realizado em relação ao previsto.</p>
      <div class="chip"><%= budgets.length %> orçamentos cadastrados</div>
    </div>

    <%- include('partials/flash') %>
    <%- include('partials/error-banner', { errors }) %>

    <form class="filters" method="get" action="/orcamento">
      <label class="field search-field search-field--narrow">
        <span>Mês</span>
        <input type="month" name="month" value="<%= filters.month || '' %>" />
      </label>
      <label class="field search-field search-field--narrow">
        <span>Status</span>
        <select name="status">
          <option value="">Todos</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Ativo</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inativo</option>
          <option value="archived" <%= filters.status === 'archived' ? 'selected' : '' %>>Arquivado</option>
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Filtrar</button>
    </form>
  </section>

  <section class="grid-2">
    <article class="surface form-card">
      <div class="page-heading">
        <span class="eyebrow">Novo orçamento</span>
        <h2 class="section-title">Cadastrar orçamento mensal</h2>
      </div>

      <% if (!categories.length) { %>
        <div class="empty-state" style="margin-bottom: 1rem;">
          <h3>Nenhuma categoria de despesa ativa</h3>
          <p>Crie categorias de despesa antes de registrar um orçamento por categoria.</p>
          <a class="btn btn--primary" href="/categorias">Ir para categorias</a>
        </div>
      <% } %>

      <form class="form-grid" method="post" action="/orcamento">
        <label class="field">
          <span>Mês</span>
          <input type="month" name="month" value="<%= values.month || '' %>" required />
          <%- include('partials/field-errors', { errors, field: 'month' }) %>
        </label>

        <label class="field">
          <span>Valor total</span>
          <input type="text" id="budgetTotalInput" name="total_amount" value="<%= values.total_amount || '' %>" placeholder="0,00" />
          <small>Se ficar em branco, o total será calculado pela soma das categorias.</small>
          <%- include('partials/field-errors', { errors, field: 'total_amount' }) %>
        </label>

        <div class="surface" style="padding: 1rem; border-radius: var(--radius-md); background: rgba(255,255,255,0.78); border: 1px solid var(--line);">
          <div class="page-heading" style="margin-bottom: 1rem;">
            <span class="eyebrow">Categorias</span>
            <h3 class="section-title" style="margin: 0;">Distribuição orçamentária</h3>
          </div>

          <div class="grid-2" style="gap: 0.85rem;">
            <% values.categories.forEach(function(item, index) { %>
              <label class="field">
                <span>Categoria <%= index + 1 %></span>
                <select name="categories[<%= index %>][category_id]">
                  <option value="">Selecione</option>
                  <% categories.forEach(function(category) { %>
                    <option value="<%= category.id %>" <%= String(item.category_id || '') === String(category.id) ? 'selected' : '' %>><%= category.label %></option>
                  <% }); %>
                </select>
              </label>

              <label class="field">
                <span>Valor</span>
                <input type="text" class="budget-amount-input" name="categories[<%= index %>][budgeted_amount]" value="<%= item.budgeted_amount || '' %>" placeholder="0,00" />
              </label>
            <% }); %>
          </div>

          <%- include('partials/field-errors', { errors, field: 'categories' }) %>
        </div>

        <button class="btn btn--primary" type="submit" <%= categories.length ? '' : 'disabled' %>>Salvar orçamento</button>
      </form>

      <script>
        (function() {
          const totalInput = document.getElementById('budgetTotalInput');
          const amountInputs = document.querySelectorAll('.budget-amount-input');

          function applyMask(input) {
            input.addEventListener('input', function(e) {
              let value = e.target.value.replace(/\D/g, '');
              if (value.length === 0) {
                e.target.value = '';
              } else {
                value = (parseInt(value) / 100).toLocaleString('pt-BR', {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                });
                e.target.value = value;
              }
            });
          }

          if (totalInput) {
            applyMask(totalInput);
          }

          amountInputs.forEach(applyMask);
        })();
      </script>
    </article>

    <article class="surface chart-card">
      <div class="page-heading">
        <span class="eyebrow">Resumo</span>
        <h2 class="section-title">Orçamento selecionado</h2>
      </div>

      <% if (selectedBudget) { %>
        <section class="metric-grid" style="margin-bottom: 1rem;">
          <article class="metric surface">
            <span class="stat-label">Orçado</span>
            <div class="metric-value metric-value--accent"><%= formatCurrency(selectedBudget.execution?.budgeted_total || selectedBudget.total_amount || 0) %></div>
          </article>
          <article class="metric surface">
            <span class="stat-label">Realizado</span>
            <div class="metric-value metric-value--negative"><%= formatCurrency(selectedBudget.execution?.actual_expenses || 0) %></div>
          </article>
          <article class="metric surface">
            <span class="stat-label">Saldo</span>
            <div class="metric-value <%= Number(selectedBudget.execution?.remaining_amount || 0) >= 0 ? 'metric-value--positive' : 'metric-value--negative' %>"><%= formatCurrency(selectedBudget.execution?.remaining_amount || 0) %></div>
          </article>
          <article class="metric surface">
            <span class="stat-label">Execução</span>
            <div class="metric-value"><%= formatPercent(selectedBudget.execution?.execution_percentage || 0) %></div>
          </article>
        </section>

        <% if (selectedBudget.execution && selectedBudget.execution.categories && selectedBudget.execution.categories.length > 0) { %>
          <canvas id="budgetDetailChart"></canvas>
        <% } else { %>
          <div class="empty-state">
            <h3>Sem categorias no orçamento</h3>
            <p>Inclua categorias para comparar o valor orçado com o realizado.</p>
          </div>
        <% } %>

        <% if (selectedBudget.execution && selectedBudget.execution.alerts && selectedBudget.execution.alerts.length > 0) { %>
          <div class="list-grid" style="margin-top: 1rem;">
            <% selectedBudget.execution.alerts.forEach(function(alert) { %>
              <div class="list-item">
                <div class="list-item__title">
                  <strong><%= alert.message %></strong>
                  <span class="badge <%= alert.type === 'exceeded' ? 'badge--danger' : alert.type === 'warning' ? 'badge--warning' : 'badge--success' %>"><%= alert.type %></span>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      <% } else { %>
        <div class="empty-state">
          <h3>Selecione um orçamento</h3>
          <p>Após criar um orçamento, escolha um registro da lista para acompanhar o realizado.</p>
        </div>
      <% } %>
    </article>
  </section>

  <section class="surface table-card">
    <div class="page-heading">
      <span class="eyebrow">Lista</span>
      <h2 class="section-title">Orçamentos cadastrados</h2>
    </div>

    <% if (budgets.length) { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Mês</th>
              <th>Total</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% budgets.forEach(function(budget) { %>
              <tr>
                <td><strong><%= budget.month %></strong></td>
                <td><%= formatCurrency(budget.total_amount || 0) %></td>
                <td><span class="badge <%= budget.status === 'active' ? 'badge--success' : budget.status === 'inactive' ? 'badge--warning' : 'badge--primary' %>"><%= budget.status %></span></td>
                <td>
                  <div class="table-actions">
                    <a class="btn btn--ghost" href="/orcamento?budget=<%= budget.id %>">Ver</a>
                    <form class="inline-form" method="post" action="/orcamento/<%= budget.id %>/finalizar">
                      <button class="btn btn--soft" type="submit">Finalizar</button>
                    </form>
                    <form class="inline-form" method="post" action="/orcamento/<%= budget.id %>/excluir">
                      <button class="btn btn--danger" type="submit" data-confirm="Excluir este orçamento?">Excluir</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>Nenhum orçamento encontrado</h3>
        <p>Cadastre o primeiro orçamento mensal para começar a acompanhar a execução.</p>
      </div>
    <% } %>
  </section>
</main>

<script>
  (function() {
    const budgetCanvas = document.getElementById('budgetDetailChart');
    if (!budgetCanvas) {
      return;
    }

    const executionData = <%- JSON.stringify(selectedBudget?.execution || null) %>;
    if (!executionData || !executionData.categories || executionData.categories.length === 0) {
      return;
    }

    new Chart(budgetCanvas, {
      type: 'bar',
      data: {
        labels: executionData.categories.map(item => item.category_name),
        datasets: [
          {
            label: 'Orçado',
            data: executionData.categories.map(item => item.budgeted_amount),
            backgroundColor: 'rgba(37, 99, 235, 0.88)',
            borderColor: '#2563eb',
            borderWidth: 1,
            borderRadius: 10,
          },
          {
            label: 'Realizado',
            data: executionData.categories.map(item => item.actual_expenses),
            backgroundColor: 'rgba(217, 119, 6, 0.84)',
            borderColor: '#d97706',
            borderWidth: 1,
            borderRadius: 10,
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        interaction: {
          mode: 'index',
          intersect: false
        },
        plugins: {
          legend: {
            position: 'top',
            labels: {
              usePointStyle: true,
              padding: 16,
              font: { size: 13, weight: '500' }
            }
          },
          tooltip: {
            backgroundColor: 'rgba(0, 0, 0, 0.8)',
            padding: 12,
            titleFont: { size: 13, weight: '600' },
            bodyFont: { size: 12 },
            cornerRadius: 6,
            callbacks: {
              label: function(context) {
                const value = new Intl.NumberFormat('pt-BR', {
                  style: 'currency',
                  currency: 'BRL'
                }).format(context.parsed.y);
                return context.dataset.label + ': ' + value;
              }
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              callback: function(value) {
                return new Intl.NumberFormat('pt-BR', {
                  notation: 'compact',
                  compactDisplay: 'short',
                  style: 'currency',
                  currency: 'BRL'
                }).format(value);
              }
            }
          }
        }
      }
    });
  })();
</script>

<%- include('partials/footer') %>
<%- include('partials/head', { bodyClass: 'page--app', pageTitle }) %>
<%- include('partials/nav-app') %>

<main class="container page-shell shell-grid">
  <section class="surface panel">
    <div class="page-heading">
      <span class="eyebrow">Lancamentos</span>
      <h1>Movimentacoes financeiras</h1>
      <p>Registre receitas, despesas e recorrencias com filtros de periodo e categoria.</p>
      <div class="chip"><%= transactions.length %> registros</div>
    </div>

    <%- include('partials/flash') %>
    <%- include('partials/error-banner', { errors }) %>

    <form class="filters" method="get" action="/lancamentos">
      <label class="field search-field search-field--narrow">
        <span>Inicio</span>
        <input type="date" name="start" value="<%= filters.start || '' %>" />
      </label>
      <label class="field search-field search-field--narrow">
        <span>Fim</span>
        <input type="date" name="end" value="<%= filters.end || '' %>" />
      </label>
      <label class="field search-field">
        <span>Categoria</span>
        <select name="category">
          <option value="">Todas</option>
          <% categories.forEach(function(category) { %>
            <option value="<%= category.id %>" <%= String(filters.category || '') === String(category.id) ? 'selected' : '' %>><%= category.label %></option>
          <% }); %>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Tipo</span>
        <select name="type">
          <option value="">Todos</option>
          <option value="receita" <%= filters.type === 'receita' ? 'selected' : '' %>>Receita</option>
          <option value="despesa" <%= filters.type === 'despesa' ? 'selected' : '' %>>Despesa</option>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Recorrente</span>
        <select name="is_recurring">
          <option value="">Todos</option>
          <option value="true" <%= filters.is_recurring === 'true' ? 'selected' : '' %>>Sim</option>
          <option value="false" <%= filters.is_recurring === 'false' ? 'selected' : '' %>>Nao</option>
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Filtrar</button>
    </form>
  </section>

  <section class="grid-2">
    <article class="surface form-card">
      <div class="page-heading">
        <span class="eyebrow">Novo lancamento</span>
        <h2 class="section-title">Cadastrar movimentacao</h2>
      </div>

      <% if (!activeCategories.length) { %>
        <div class="empty-state" style="margin-bottom: 1rem;">
          <h3>Nenhuma categoria ativa</h3>
          <p>Crie uma categoria ativa antes de registrar novos lancamentos.</p>
          <a class="btn btn--primary" href="/categorias">Ir para categorias</a>
        </div>
      <% } %>

      <form class="form-grid" method="post" action="/lancamentos">
        <label class="field">
          <span>Categoria</span>
          <select name="category" required <%= activeCategories.length ? '' : 'disabled' %>>
            <option value="">Selecione</option>
            <% activeCategories.forEach(function(category) { %>
              <option value="<%= category.id %>" <%= String(values.category || '') === String(category.id) ? 'selected' : '' %>><%= category.label %></option>
            <% }); %>
          </select>
          <%- include('partials/field-errors', { errors, field: 'category' }) %>
        </label>

        <div class="grid-2">
          <label class="field">
            <span>Tipo</span>
            <select name="type" required>
              <option value="receita" <%= values.type === 'receita' ? 'selected' : '' %>>Receita</option>
              <option value="despesa" <%= values.type === 'despesa' ? 'selected' : '' %>>Despesa</option>
            </select>
            <%- include('partials/field-errors', { errors, field: 'type' }) %>
          </label>

          <label class="field">
            <span>Data</span>
            <input type="date" name="date" value="<%= values.date || '' %>" required />
            <%- include('partials/field-errors', { errors, field: 'date' }) %>
          </label>
        </div>

        <label class="field">
          <span>Descricao</span>
          <input type="text" name="description" value="<%= values.description || '' %>" maxlength="255" required />
          <%- include('partials/field-errors', { errors, field: 'description' }) %>
        </label>

        <div class="grid-2">
          <label class="field">
            <span>Valor</span>
            <input type="text" id="amountInput" name="amount" value="<%= values.amount || '' %>" placeholder="0,00" required />
            <%- include('partials/field-errors', { errors, field: 'amount' }) %>
          </label>

          <label class="field" style="display:flex; align-items:center; gap:0.65rem; margin-top: 1.9rem;">
            <input type="checkbox" id="recurringCheckbox" name="is_recurring" value="true" <%= values.is_recurring ? 'checked' : '' %> />
            <span>Recorrente</span>
          </label>
        </div>

        <div id="recurringFields" class="grid-3" style="display: <%= values.is_recurring ? 'grid' : 'none' %>;">
          <label class="field">
            <span>Frequencia</span>
            <select name="frequency">
              <option value="">Selecione</option>
              <option value="daily" <%= values.frequency === 'daily' ? 'selected' : '' %>>Diaria</option>
              <option value="weekly" <%= values.frequency === 'weekly' ? 'selected' : '' %>>Semanal</option>
              <option value="monthly" <%= values.frequency === 'monthly' ? 'selected' : '' %>>Mensal</option>
              <option value="yearly" <%= values.frequency === 'yearly' ? 'selected' : '' %>>Anual</option>
            </select>
            <%- include('partials/field-errors', { errors, field: 'frequency' }) %>
          </label>

          <label class="field">
            <span>Inicio da recorrencia</span>
            <input type="date" name="start_date" value="<%= values.start_date || '' %>" />
            <%- include('partials/field-errors', { errors, field: 'start_date' }) %>
          </label>

          <label class="field">
            <span>Fim da recorrencia</span>
            <input type="date" name="end_date" value="<%= values.end_date || '' %>" />
            <%- include('partials/field-errors', { errors, field: 'end_date' }) %>
          </label>
        </div>

        <button class="btn btn--primary" type="submit" <%= activeCategories.length ? '' : 'disabled' %>>Salvar lancamento</button>
      </form>

      <script>
        (function() {
          const recurringCheckbox = document.getElementById('recurringCheckbox');
          const recurringFields = document.getElementById('recurringFields');

          if (recurringCheckbox && recurringFields) {
            recurringCheckbox.addEventListener('change', function() {
              recurringFields.style.display = this.checked ? 'grid' : 'none';
            });
          }

          // Máscara monetária em BRL
          const amountInput = document.getElementById('amountInput');
          if (amountInput) {
            amountInput.addEventListener('input', function(e) {
              let value = e.target.value.replace(/\D/g, '');
              if (value.length === 0) {
                e.target.value = '';
              } else {
                value = (parseInt(value) / 100).toLocaleString('pt-BR', {
                  minimumFractionDigits: 2,
                  maximumFractionDigits: 2
                });
                e.target.value = value;
              }
            });
          }
        })();
      </script>
    </article>

    <article class="surface table-card">
      <div class="page-heading">
        <span class="eyebrow">Historico</span>
        <h2 class="section-title">Lancamentos registrados</h2>
<script>
  // Máscara monetária BRL para campo de valor
  (function() {
    const amountInput = document.getElementById('amountInput');
    if (amountInput) {
      amountInput.addEventListener('input', function(e) {
        let value = e.target.value.replace(/\D/g, '');
        if (value.length === 0) {
          e.target.value = '';
        } else {
          value = (parseInt(value) / 100).toLocaleString('pt-BR', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          });
          e.target.value = value;
        }
      });
    }
  })();
</script>
      </div>

      <% if (transactions.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Descricao</th>
                <th>Categoria</th>
                <th>Tipo</th>
                <th>Data</th>
                <th>Valor</th>
                <th>Recorrente</th>
                <th>Status</th>
                <th>Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% transactions.forEach(function(transaction) { %>
                <tr>
                  <td><strong><%= transaction.description %></strong></td>
                  <td><%= transaction.category_name || transaction.category?.name || transaction.category || '—' %></td>
                  <td><span class="badge <%= transaction.type === 'receita' ? 'badge--success' : 'badge--danger' %>"><%= transaction.type %></span></td>
                  <td><%= formatDate(transaction.date) %></td>
                  <td><%= formatCurrency(transaction.amount || 0) %></td>
                  <td><span class="badge <%= transaction.is_recurring ? 'badge--primary' : 'badge--warning' %>"><%= transaction.is_recurring ? 'Sim' : 'Nao' %></span></td>
                  <td><span class="badge <%= transaction.is_active ? 'badge--success' : 'badge--warning' %>"><%= transaction.is_active ? 'Ativo' : 'Inativo' %></span></td>
                  <td>
                    <div class="table-actions">
                      <a class="btn btn--ghost" href="/lancamentos/<%= transaction.id %>/editar">Editar</a>
                      <form class="inline-form" method="post" action="/lancamentos/<%= transaction.id %>/excluir">
                        <button class="btn btn--danger" type="submit" data-confirm="Remover este lancamento?">Excluir</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>Nenhum lancamento encontrado</h3>
          <p>Use o formulario ao lado para cadastrar sua primeira movimentacao.</p>
        </div>
      <% } %>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
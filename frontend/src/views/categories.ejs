<%- include('partials/head', { bodyClass: 'page--app', pageTitle }) %>
<%- include('partials/nav-app') %>

<main class="container page-shell shell-grid">
  <section class="surface panel">
    <div class="page-heading">
      <div>
        <span class="eyebrow">Categorias</span>
        <h1>Gestao de categorias</h1>
        <p>Crie categorias para receitas e despesas, filtre por tipo e altere o status sem perder o historico.</p>
      </div>
      <div class="chip"><%= categories.length %> registros</div>
    </div>

    <%- include('partials/flash') %>
    <%- include('partials/error-banner', { errors }) %>

    <form class="filters" method="get" action="/categorias">
      <label class="field search-field search-field--narrow">
        <span>Tipo</span>
        <select name="type">
          <option value="">Todos</option>
          <option value="receita" <%= filters.type === 'receita' ? 'selected' : '' %>>Receita</option>
          <option value="despesa" <%= filters.type === 'despesa' ? 'selected' : '' %>>Despesa</option>
        </select>
      </label>
      <label class="field search-field search-field--narrow">
        <span>Status</span>
        <select name="is_active">
          <option value="">Todos</option>
          <option value="true" <%= filters.is_active === 'true' ? 'selected' : '' %>>Ativas</option>
          <option value="false" <%= filters.is_active === 'false' ? 'selected' : '' %>>Inativas</option>
        </select>
      </label>
      <button class="btn btn--primary" type="submit">Filtrar</button>
    </form>
  </section>

  <section class="grid-2">
    <article class="surface form-card">
      <div class="page-heading">
        <div>
          <span class="eyebrow">Nova categoria</span>
          <h2 class="section-title">Cadastrar categoria</h2>
        </div>
      </div>

      <form class="form-grid" method="post" action="/categorias">
        <label class="field">
          <span>Nome</span>
          <input type="text" name="name" value="<%= values.name || '' %>" maxlength="120" required />
          <%- include('partials/field-errors', { errors, field: 'name' }) %>
        </label>

        <label class="field">
          <span>Tipo</span>
          <select name="type" required>
            <option value="">Selecione</option>
            <option value="receita" <%= values.type === 'receita' ? 'selected' : '' %>>Receita</option>
            <option value="despesa" <%= values.type === 'despesa' ? 'selected' : '' %>>Despesa</option>
          </select>
          <%- include('partials/field-errors', { errors, field: 'type' }) %>
        </label>

        <label class="field">
          <span>Descricao</span>
          <textarea name="description" maxlength="500" placeholder="Opcional"><%= values.description || '' %></textarea>
          <%- include('partials/field-errors', { errors, field: 'description' }) %>
        </label>

        <label class="field">
          <span>Status</span>
          <select name="is_active" required>
            <option value="true" <%= String(values.is_active) === 'true' ? 'selected' : '' %>>Ativa</option>
            <option value="false" <%= String(values.is_active) === 'false' ? 'selected' : '' %>>Inativa</option>
          </select>
          <%- include('partials/field-errors', { errors, field: 'is_active' }) %>
        </label>

        <button class="btn btn--primary" type="submit">Salvar categoria</button>
      </form>
    </article>

    <article class="surface table-card">
      <div class="page-heading">
        <div>
          <span class="eyebrow">Lista</span>
          <h2 class="section-title">Categorias cadastradas</h2>
        </div>
      </div>

      <% if (categories.length) { %>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>Descricao</th>
                <th>Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% categories.forEach(function(category) { %>
                <tr>
                  <td><strong><%= category.name %></strong></td>
                  <td><span class="badge <%= category.type === 'receita' ? 'badge--success' : 'badge--danger' %>"><%= category.type %></span></td>
                  <td>
                    <span class="badge <%= category.is_active ? 'badge--success' : 'badge--warning' %>"><%= category.is_active ? 'Ativa' : 'Inativa' %></span>
                  </td>
                  <td><%= category.description || '—' %></td>
                  <td>
                    <div class="table-actions">
                      <a class="btn btn--ghost" href="/categorias/<%= category.id %>/editar">Editar</a>
                      <form class="inline-form" method="post" action="/categorias/<%= category.id %>/status">
                        <input type="hidden" name="is_active" value="<%= category.is_active ? 'false' : 'true' %>" />
                        <button class="btn <%= category.is_active ? 'btn--soft' : 'btn--primary' %>" type="submit"><%= category.is_active ? 'Desativar' : 'Ativar' %></button>
                      </form>
                      <form class="inline-form" method="post" action="/categorias/<%= category.id %>/excluir">
                        <button class="btn btn--danger" type="submit" data-confirm="Remover esta categoria?">Excluir</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <h3>Nenhuma categoria encontrada</h3>
          <p>Cadastre sua primeira categoria para organizar receitas e despesas.</p>
        </div>
      <% } %>
    </article>
  </section>
</main>

<%- include('partials/footer') %>
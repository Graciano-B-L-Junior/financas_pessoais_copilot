<%- include('partials/head', { bodyClass: 'page--public', pageTitle }) %>
<%- include('partials/nav-public') %>

<main class="container page-shell">
  <div class="auth-layout">
    <section class="auth-visual surface">
      <span class="eyebrow">Acesso seguro</span>
      <h2>Entre para controlar categorias, lancamentos e indicadores.</h2>
      <p>O front preserva a sessao em cookies HttpOnly e redireciona para o painel quando a autenticacao e valida.</p>
      <div class="hero-preview">
        <div class="hero-preview__grid">
          <div class="hero-preview__mini"><strong>Resumo rapido</strong><span>Dashboard</span></div>
          <div class="hero-preview__mini"><strong>Operacoes</strong><span>CRUD</span></div>
          <div class="hero-preview__mini"><strong>Alertas</strong><span>Insights</span></div>
          <div class="hero-preview__mini"><strong>Conta</strong><span>Perfil</span></div>
        </div>
      </div>
      <ul>
        <li>Tokens guardados fora do JavaScript do navegador.</li>
        <li>Reaproveitamento de sessao via refresh automatico.</li>
        <li>Mensagens de erro inline para email e senha.</li>
      </ul>
    </section>

    <section class="auth-card surface surface--strong">
      <div>
        <h1>Entrar</h1>
        <p>Acesse sua area financeira com seguranca e sem etapas desnecessarias.</p>
      </div>

      <%- include('partials/flash') %>
      <%- include('partials/error-banner', { errors }) %>

      <form class="form-grid" method="post" action="/login">
        <input type="hidden" name="next" value="<%= next %>" />

        <label class="field">
          <span>Email</span>
          <input type="email" name="email" value="<%= values.email || '' %>" autocomplete="email" required />
          <%- include('partials/field-errors', { errors, field: 'email' }) %>
        </label>

        <label class="field">
          <span>Senha</span>
          <input type="password" name="password" autocomplete="current-password" required />
          <%- include('partials/field-errors', { errors, field: 'password' }) %>
        </label>

        <button class="btn btn--primary btn--block" type="submit">Entrar</button>
      </form>

      <p class="help">Ainda nao tem conta? <a href="/register">Crie sua conta</a>.</p>
    </section>
  </div>
</main>

<%- include('partials/footer') %>